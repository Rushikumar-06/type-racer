# Local combined Next.js + Socket.IO server defaults (optional runtime variables).
# PORT=3000
# HOST=0.0.0.0

# Vercel frontend: the HTTPS origin of your Render multiplayer service.
# Leave unset for local combined development.
# NEXT_PUBLIC_SOCKET_URL=https://your-race-server.onrender.com

# Render multiplayer server: exact frontend origins, no trailing slash.
# Set in the Render dashboard; multiplayer-server.ts reads runtime variables.
# ALLOWED_ORIGINS=https://your-game.vercel.app
